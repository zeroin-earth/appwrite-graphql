{
  "compilerOptions": {
    "target": "es2022",
    "module": "CommonJS",
    "sourceMap": true,
    "outDir": "./out",
    "skipLibCheck": true,
    "jsx": "react",
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./src/schema.graphql",
        "tadaOutputLocation": "./src/graphql-env.d.ts"
      }
    ]
  },
  "exclude": ["scripts"]
}
